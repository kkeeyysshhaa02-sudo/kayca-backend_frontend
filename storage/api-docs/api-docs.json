                                                        "type": "string",
                                                        "example": "Mengerjakan LKPD Duo Developer"
                                                    },
                                                    "description": {
                                                        "type": "string",
                                                        "example": "Backend Laravel + Swagger"
                                                    },
                                                    "status": {
                                                        "type": "string",
                                                        "example": "todo",
